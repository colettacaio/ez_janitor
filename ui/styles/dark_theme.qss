* {
    color: #f0f0f0;
    background-color: #1e1e1e;
    font-family: "Segoe UI", sans-serif;
}

QMainWindow {
    background-color: #1e1e1e;
}

QTabWidget::pane {
    border-top: 2px solid #2d2d2d;
}

QTabBar::tab {
    background: #2d2d2d;
    padding: 10px;
    margin-right: 2px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
}

QTabBar::tab:selected {
    background: #3c3c3c;
}

QPushButton {
    background-color: #3a3a3a;
    border: 1px solid #555;
    padding: 8px 12px;
    border-radius: 6px;
}

QPushButton:hover {
    background-color: #4a4a4a;
}

QPushButton:pressed {
    background-color: #2d2d2d;
}

QLabel {
    font-size: 14px;
}

FolderPicker QLabel {
    background-color: #2d2d2d;
    border: 1px solid #444;
    border-radius: 6px;
}

FolderPicker QPushButton {
    background-color: #3a3a3a;
}

FolderPicker QPushButton:hover {
    background-color: #4a4a4a;
}
QTableWidget {
    gridline-color: #444;
    background-color: #1e1e1e;
    alternate-background-color: #262626;
    color: #dddddd;
    selection-background-color: #004225;
}

QHeaderView::section {
    background-color: #2d2d2d;
    padding: 4px;
    border: 1px solid #444;
    font-weight: bold;
}
/* Sidebar */
QListWidget {
    background-color: #1c1c1c;
    border-right: 1px solid #333;
}

QListWidget::item {
    padding: 10px;
}

QListWidget::item:selected {
    background-color: #004225;
    color: white;
}

QListWidget::item:hover {
    background-color: #2a2a2a;
}

/* Table hover */
QTableWidget::item:hover {
    background-color: #2f2f2f;
}

/* Cursor feedback */
QPushButton {
    cursor: pointer;
}

QTableWidget {
    border: none;
}
